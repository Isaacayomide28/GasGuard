{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gasguard.dev/schemas/rule-config.schema.json",
  "title": "GasGuard Rule Configuration",
  "description": "Schema for a single analyzer rule configuration entry as stored in gasguard.config.json's \"rules\" array or passed to RuleConfigService/ConfigManager.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "enabled", "severity", "category", "language"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$",
      "description": "Lowercase alphanumeric identifier with hyphens, unique across the rule set."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-.*)?$",
      "description": "Semantic version of the rule definition, e.g. \"1.0.0\"."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "customRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "conditions", "actions"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "operator", "value"],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equals",
                  "not_equals",
                  "contains",
                  "not_contains",
                  "greater_than",
                  "less_than",
                  "in",
                  "not_in"
                ]
              },
              "value": {},
              "caseSensitive": {
                "type": "boolean"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["warn", "error", "info", "custom"]
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low", "info"]
              },
              "metadata": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
